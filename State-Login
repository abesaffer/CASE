<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>CASE | State Advocacy Portal</title>
<style>
:root {
  --red: #A71930;
  --red-dark: #801126;
  --ink: #263342;
  --muted: #637181;
  --border: #dfe4ea;
  --bg: #f5f6f8;
  --white: #fff;
  --green: #21784b;
  --amber: #926000;
}
* { box-sizing: border-box; }
body {
  margin: 0;
  font-family: Arial, Helvetica, sans-serif;
  color: var(--ink);
  background: var(--bg);
  line-height: 1.5;
}
button, input, select, textarea { font: inherit; }
button { cursor: pointer; }
button:focus-visible, input:focus-visible,
textarea:focus-visible, select:focus-visible {
  outline: 3px solid #e9a4b0;
  outline-offset: 2px;
}
.topbar {
  background: white;
  border-bottom: 4px solid var(--red);
}
.topbar-inner {
  max-width: 1160px;
  margin: auto;
  padding: 16px 24px;
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 16px;
}
.brand { display: flex; align-items: center; gap: 15px; }
.brand-mark {
  background: var(--red);
  color: white;
  font-weight: 800;
  font-size: 25px;
  padding: 9px 13px;
  letter-spacing: -1px;
}
.brand-title { font-weight: 800; font-size: 17px; }
.brand-subtitle { color: var(--muted); font-size: 12px; }
.account { text-align: right; font-size: 13px; }
.account span { display: block; color: var(--muted); }
.wrapper { max-width: 1160px; margin: auto; padding: 26px 24px 60px; }
.hero {
  background: var(--red);
  color: white;
  padding: 30px 35px;
  border-radius: 10px;
  margin-bottom: 20px;
}
.eyebrow {
  text-transform: uppercase;
  letter-spacing: 1.7px;
  font-size: 11px;
  font-weight: 800;
}
.hero h1 { margin: 9px 0; font-size: 30px; }
.hero p { margin: 0; max-width: 690px; }
.demo {
  padding: 11px 15px;
  background: #fff5dc;
  color: #684b14;
  border: 1px solid #ebd49c;
  border-radius: 7px;
  margin-bottom: 20px;
  font-size: 13px;
}
.layout {
  display: grid;
  grid-template-columns: 240px minmax(0, 1fr);
  gap: 22px;
  align-items: start;
}
.sidebar, .panel, .stat {
  background: white;
  border: 1px solid var(--border);
  border-radius: 9px;
}
.sidebar { padding: 12px; }
.nav-button {
  width: 100%;
  text-align: left;
  border: 0;
  border-radius: 6px;
  background: transparent;
  color: var(--ink);
  padding: 13px;
  margin-bottom: 4px;
  font-weight: 700;
}
.nav-button.active {
  background: #f8e9ec;
  color: var(--red);
  border-left: 4px solid var(--red);
}
.nav-button:hover { background: #f4f4f5; }
.sidebar-note {
  border-top: 1px solid var(--border);
  margin-top: 16px;
  padding: 16px 10px 5px;
  color: var(--muted);
  font-size: 12px;
}
.main { min-width: 0; }
.page-heading { margin: 0 0 5px; font-size: 23px; }
.page-intro { color: var(--muted); margin: 0 0 22px; }
.stats {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 12px;
  margin-bottom: 22px;
}
.stat { padding: 18px; }
.stat-number { font-size: 29px; font-weight: 800; color: var(--red); }
.stat-label { font-size: 12px; color: var(--muted); }
.panel { padding: 24px; margin-bottom: 18px; }
.panel h2 { margin: 0 0 8px; font-size: 20px; }
.panel h3 { font-size: 16px; margin: 0 0 6px; }
.panel p { color: var(--muted); margin-top: 0; }
.card-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 14px;
  margin-top: 18px;
}
.action-card {
  border: 1px solid var(--border);
  border-radius: 8px;
  padding: 19px;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
}
.action-card p { font-size: 13px; flex: 1; }
.card-icon { font-size: 23px; margin-bottom: 10px; }
.btn {
  background: var(--red);
  color: white;
  border: 1px solid var(--red);
  border-radius: 6px;
  padding: 10px 16px;
  font-weight: 700;
  font-size: 13px;
}
.btn:hover { background: var(--red-dark); }
.btn-secondary {
  background: white;
  color: var(--red);
}
.btn-secondary:hover { background: #fbedf0; }
.btn-small { font-size: 12px; padding: 8px 12px; }
.badge {
  display: inline-block;
  border-radius: 20px;
  font-weight: 700;
  font-size: 11px;
  padding: 4px 9px;
}
.badge-green { color: var(--green); background: #e8f5ec; }
.badge-amber { color: var(--amber); background: #fff4d7; }
.badge-red { color: var(--red); background: #f9e8ec; }
.field { margin-bottom: 19px; }
.field label { display: block; font-weight: 700; margin-bottom: 6px; }
.field input, .field select, .field textarea {
  display: block;
  width: 100%;
  background: white;
  border: 1px solid #bcc5cf;
  border-radius: 5px;
  padding: 11px;
  color: var(--ink);
}
.field textarea { min-height: 115px; resize: vertical; }
.help { color: var(--muted); font-size: 12px; margin-top: 5px; }
.form-actions { display: flex; gap: 10px; flex-wrap: wrap; }
.info-box {
  background: #f5f7fa;
  border-left: 4px solid var(--red);
  padding: 14px 16px;
  margin: 14px 0 22px;
  font-size: 13px;
}
.activity {
  display: flex;
  justify-content: space-between;
  gap: 12px;
  padding: 13px 0;
  border-bottom: 1px solid var(--border);
  align-items: center;
}
.activity:last-child { border: 0; }
.activity-title { font-weight: 700; font-size: 14px; }
.activity-detail { color: var(--muted); font-size: 12px; }
.section { display: none; }
.section.active { display: block; }
.preview {
  border: 1px solid var(--border);
  border-radius: 7px;
  overflow: hidden;
  margin-top: 15px;
}
.preview-header {
  background: var(--red);
  color: white;
  padding: 21px;
}
.preview-header h3 { margin: 4px 0; font-size: 23px; }
.preview-body { padding: 21px; }
.preview-body h4 { color: var(--red); margin-bottom: 6px; }
.preview-body p { white-space: pre-wrap; overflow-wrap: anywhere; }
.notice {
  padding: 12px 15px;
  border-radius: 6px;
  margin-bottom: 16px;
  background: #e9f4ed;
  border: 1px solid #aad4b7;
  color: #155a33;
}
.footer {
  text-align: center;
  padding: 32px 15px;
  font-size: 12px;
  color: var(--muted);
}
@media(max-width: 800px) {
  .layout { grid-template-columns: 1fr; }
  .sidebar { display: flex; overflow-x: auto; gap: 5px; }
  .nav-button { white-space: nowrap; width: auto; }
  .sidebar-note { display: none; }
  .hero { padding: 24px; }
}
@media(max-width: 550px) {
  .wrapper { padding: 15px; }
  .topbar-inner { padding: 12px; }
  .brand-title { font-size: 14px; }
  .account { font-size: 11px; }
  .hero h1 { font-size: 24px; }
  .stats { grid-template-columns: 1fr 1fr; }
  .card-grid { grid-template-columns: 1fr; }
  .panel { padding: 18px; }
}
</style>
</head>
<body>

<header class="topbar">
  <div class="topbar-inner">
    <div class="brand">
      <div class="brand-mark">CASE</div>
      <div>
        <div class="brand-title">Legislative Action Center</div>
        <div class="brand-subtitle">State Advocacy Management Portal</div>
      </div>
    </div>
    <div class="account">
      <strong>State President</strong>
      <span>Illinois | Demo Account</span>
    </div>
  </div>
</header>

<div class="wrapper">
  <div class="hero">
    <div class="eyebrow">CASE State Advocacy</div>
    <h1>Welcome, Illinois State President</h1>
    <p>Manage your state's advocacy information, share resources,
    and work with CASE national on legislative priorities
    and grassroots campaigns.</p>
  </div>

  <div class="demo" role="note">
    <strong>Demonstration portal:</strong>
    This page saves example content in this browser only.
    It does not connect to Quorum, publish to a public website,
    authenticate users, or submit requests to CASE national.
  </div>

  <div class="layout">
    <nav class="sidebar" aria-label="Portal navigation">
      <button class="nav-button active" data-section="dashboard">Dashboard</button>
      <button class="nav-button" data-section="edit">Edit State Page</button>
      <button class="nav-button" data-section="resources">Events & Resources</button>
      <button class="nav-button" data-section="positions">Legislative Positions</button>
      <button class="nav-button" data-section="campaigns">Advocacy Campaigns</button>
      <button class="nav-button" data-section="requests">My Requests</button>
      <button class="nav-button" data-section="preview">Preview State Page</button>
      <div class="sidebar-note">
        Routine state content can be published directly.
        Legislative positions and grassroots campaigns
        require CASE national approval.
      </div>
    </nav>

    <main class="main" id="main">

      <section id="dashboard" class="section active">
        <h2 class="page-heading">Your Advocacy Dashboard</h2>
        <p class="page-intro">An overview of your state's advocacy information.</p>

        <div class="stats">
          <div class="stat">
            <div class="stat-number" id="update-count">0</div>
            <div class="stat-label">Published demo updates</div>
          </div>
          <div class="stat">
            <div class="stat-number" id="pending-count">0</div>
            <div class="stat-label">Requests pending</div>
          </div>
          <div class="stat">
            <div class="stat-number">IL</div>
            <div class="stat-label">Assigned state</div>
          </div>
        </div>

        <div class="panel">
          <h2>What would you like to do?</h2>
          <p>Select an activity to update your state page or request national assistance.</p>

          <div class="card-grid">
            <div class="action-card">
              <div class="card-icon" aria-hidden="true">✎</div>
              <h3>Edit State Page</h3>
              <p>Update state priorities, announcements, and contact information.</p>
              <button class="btn" data-go="edit">Edit Page</button>
            </div>

            <div class="action-card">
              <div class="card-icon" aria-hidden="true">▤</div>
              <h3>Events & Resources</h3>
              <p>Share state events, training opportunities, and useful materials.</p>
              <button class="btn" data-go="resources">Add Content</button>
            </div>

            <div class="action-card">
              <div class="card-icon" aria-hidden="true">⚖</div>
              <h3>Legislative Positions</h3>
              <p>Request review of a proposed support, oppose, or neutral position.</p>
              <span class="badge badge-amber">National approval required</span>
              <p></p>
              <button class="btn" data-go="positions">Request Review</button>
            </div>

            <div class="action-card">
              <div class="card-icon" aria-hidden="true">▣</div>
              <h3>Grassroots Campaigns</h3>
              <p>Propose a campaign to engage members and policymakers.</p>
              <span class="badge badge-amber">National approval required</span>
              <p></p>
              <button class="btn" data-go="campaigns">Propose Campaign</button>
            </div>
          </div>
        </div>

        <div class="panel">
          <h2>Recent Activity</h2>
          <div id="dashboard-activity">
            <p>No demo activity yet. Try publishing an update.</p>
          </div>
        </div>
      </section>

      <section id="edit" class="section">
        <h2 class="page-heading">Edit Your State Page</h2>
        <p class="page-intro">Keep your state unit's public advocacy information current.</p>

        <div class="panel">
          <span class="badge badge-green">Routine content: direct publishing</span>
          <div class="info-box">
            You may publish general state information. Official positions
            on legislation and calls for grassroots legislative action
            must go through the national approval process.
          </div>

          <form id="state-form">
            <div class="field">
              <label for="state-intro">Welcome Message</label>
              <textarea id="state-intro" required></textarea>
            </div>

            <div class="field">
              <label for="state-priorities">State Advocacy Priorities</label>
              <textarea id="state-priorities" required></textarea>
              <div class="help">Describe broad policy goals, not positions on individual bills.</div>
            </div>

            <div class="field">
              <label for="state-news">State News & Announcements</label>
              <textarea id="state-news"></textarea>
            </div>

            <div class="field">
              <label for="state-contact">State Advocacy Contact</label>
              <input id="state-contact" type="text"
                placeholder="Name, title, or public contact information">
            </div>

            <div class="form-actions">
              <button type="submit" class="btn">Publish Routine Updates</button>
              <button type="button" class="btn btn-secondary" data-go="preview">
                Preview Page
              </button>
            </div>
          </form>
        </div>
      </section>

      <section id="resources" class="section">
        <h2 class="page-heading">Events & Resources</h2>
        <p class="page-intro">Share useful information with your state's members.</p>

        <div class="panel">
          <span class="badge badge-green">Direct publishing</span>
          <div class="info-box">
            General events, training, and informational resources
            may be published directly. Campaign mobilization
            requests require national approval.
          </div>
          <form id="resource-form">
            <div class="field">
              <label for="resource-type">Content Type</label>
              <select id="resource-type">
                <option>Event</option>
                <option>Training</option>
                <option>Resource</option>
                <option>General Announcement</option>
              </select>
            </div>
            <div class="field">
              <label for="resource-title">Title</label>
              <input id="resource-title" required>
            </div>
            <div class="field">
              <label for="resource-description">Description</label>
              <textarea id="resource-description" required></textarea>
            </div>
            <div class="field">
              <label for="resource-url">Optional Resource or Event Link</label>
              <input type="url" id="resource-url" placeholder="https://">
            </div>
            <button class="btn" type="submit">Publish Content</button>
          </form>
        </div>
      </section>

      <section id="positions" class="section">
        <h2 class="page-heading">Legislative Position Requests</h2>
        <p class="page-intro">Submit a legislative proposal for CASE national review.</p>

        <div class="panel">
          <span class="badge badge-amber">National approval required</span>
          <div class="info-box">
            Submitting a request does not establish an official CASE
            position. CASE national must review and approve it first.
          </div>

          <form id="position-form">
            <div class="field">
              <label for="bill-number">Bill Number or Policy Proposal</label>
              <input id="bill-number" placeholder="e.g., HB 1234" required>
            </div>
            <div class="field">
              <label for="bill-title">Bill or Proposal Title</label>
              <input id="bill-title" required>
            </div>
            <div class="field">
              <label for="position-choice">Requested Position</label>
              <select id="position-choice">
                <option>Support</option>
                <option>Oppose</option>
                <option>Neutral</option>
                <option>Request Guidance</option>
              </select>
            </div>
            <div class="field">
              <label for="position-reason">Reason for the Request</label>
              <textarea id="position-reason" required
                placeholder="Explain how the proposal affects special education administrators, schools, or students."></textarea>
            </div>
            <div class="field">
              <label for="position-deadline">Relevant Deadline (optional)</label>
              <input type="date" id="position-deadline">
            </div>
            <button class="btn" type="submit">Submit Position for Review</button>
          </form>
        </div>
      </section>

      <section id="campaigns" class="section">
        <h2 class="page-heading">Request a Grassroots Campaign</h2>
        <p class="page-intro">Propose an advocacy action for CASE national consideration.</p>

        <div class="panel">
          <span class="badge badge-amber">National approval required</span>
          <div class="info-box">
            CASE national must approve the campaign language and
            legislative position before any Quorum campaign is activated.
          </div>

          <form id="campaign-form">
            <div class="field">
              <label for="campaign-title">Campaign Title</label>
              <input id="campaign-title" required>
            </div>
            <div class="field">
              <label for="campaign-bill">Related Legislation (if applicable)</label>
              <input id="campaign-bill">
            </div>
            <div class="field">
              <label for="campaign-goal">What Should Advocates Do?</label>
              <select id="campaign-goal">
                <option>Contact State Legislators</option>
                <option>Contact the Governor</option>
                <option>Request a Policymaker Meeting</option>
                <option>Other</option>
              </select>
            </div>
            <div class="field">
              <label for="campaign-description">Campaign Description & Rationale</label>
              <textarea id="campaign-description" required></textarea>
            </div>
            <div class="field">
              <label for="campaign-deadline">Requested Launch Deadline (optional)</label>
              <input type="date" id="campaign-deadline">
            </div>
            <button class="btn" type="submit">Submit Campaign for Approval</button>
          </form>
        </div>
      </section>

      <section id="requests" class="section">
        <h2 class="page-heading">My Requests</h2>
        <p class="page-intro">Review the legislative positions and campaigns submitted for national approval.</p>
        <div class="panel">
          <h2>Approval Queue</h2>
          <div id="request-list">
            <p>No requests have been submitted.</p>
          </div>
        </div>
      </section>

      <section id="preview" class="section">
        <h2 class="page-heading">Preview Your Public State Page</h2>
        <p class="page-intro">
          This is how routine published content could appear to CASE members.
        </p>

        <div class="panel">
          <div class="preview">
            <div class="preview-header">
              <div class="eyebrow">CASE Legislative Action Center</div>
              <h3>Illinois State Advocacy</h3>
              <div>Supporting special education leadership through advocacy.</div>
            </div>
            <div class="preview-body">
              <h4>Welcome</h4>
              <p id="preview-intro"></p>

              <h4>Advocacy Priorities</h4>
              <p id="preview-priorities"></p>

              <h4>State News & Announcements</h4>
              <p id="preview-news"></p>

              <h4>Events & Resources</h4>
              <div id="preview-resources"></div>

              <h4>Approved Advocacy Campaigns</h4>
              <p>CASE-approved campaigns will appear here
              after activation in Quorum.</p>

              <h4>State Advocacy Contact</h4>
              <p id="preview-contact"></p>
            </div>
          </div>
        </div>
      </section>

      <div id="notification" role="status" aria-live="polite"></div>
    </main>
  </div>
</div>

<footer class="footer">
  Council of Administrators of Special Education (CASE)<br>
  State Advocacy Management Portal | Demonstration Prototype
</footer>

<script>
"use strict";

// Front-end demonstration only. In production, replace browser
// storage with authenticated server-side data and permissions.

const KEY = "case-state-advocacy-demo-v1";

const defaults = {
  state: {
    intro: "Welcome to our state advocacy page. Learn how special education leaders are working to strengthen services and supports.",
    priorities: "Strengthening the special education workforce\nImproving access to related services\nSupporting effective IDEA implementation",
    news: "State news and announcements will appear here.",
    contact: "State Advocacy Leadership"
  },
  resources: [],
  requests: [],
  updateCount: 0,
  activity: []
};

function loadData() {
  try {
    const saved = JSON.parse(localStorage.getItem(KEY));
    if (saved && typeof saved === "object" && saved.state &&
        Array.isArray(saved.resources) &&
        Array.isArray(saved.requests) &&
        Array.isArray(saved.activity)) return saved;
  } catch (error) {
    console.warn("Could not load local demo data.", error);
  }
  return structuredClone(defaults);
}

let data = loadData();

function saveData() {
  localStorage.setItem(KEY, JSON.stringify(data));
  refresh();
}

function el(id) { return document.getElementById(id); }
function value(id) { return el(id).value.trim(); }

function node(tag, className, content) {
  const item = document.createElement(tag);
  if (className) item.className = className;
  if (content !== undefined) item.textContent = content;
  return item;
}

function showSection(id) {
  document.querySelectorAll(".section").forEach(section => {
    section.classList.toggle("active", section.id === id);
  });
  document.querySelectorAll(".nav-button").forEach(button => {
    const active = button.dataset.section === id;
    button.classList.toggle("active", active);
    if (active) button.setAttribute("aria-current", "page");
    else button.removeAttribute("aria-current");
  });
  refresh();
  window.scrollTo({ top: 0, behavior: "smooth" });
}

function notify(message) {
  const area = el("notification");
  area.replaceChildren(node("div", "notice", message));
  area.scrollIntoView({ behavior: "smooth", block: "nearest" });
}

function addActivity(title, description) {
  data.activity.unshift({
    title, description,
    date: new Date().toLocaleDateString()
  });
}

function showActivity(containerId, entries, emptyText) {
  const container = el(containerId);
  container.replaceChildren();
  if (!entries.length) {
    container.append(node("p", "", emptyText));
    return;
  }
  entries.forEach(item => {
    const row = node("div", "activity");
    const left = node("div");
    left.append(
      node("div", "activity-title", item.title),
      node("div", "activity-detail",
        (item.description || "") + " · " + item.date)
    );
    row.append(left);
    container.append(row);
  });
}

function refresh() {
  el("update-count").textContent = data.updateCount;
  el("pending-count").textContent =
    data.requests.filter(r => r.status === "Pending National Review").length;

  showActivity("dashboard-activity", data.activity.slice(0, 5),
    "No demo activity yet. Try publishing an update.");

  const requestContainer = el("request-list");
  requestContainer.replaceChildren();
  if (!data.requests.length) {
    requestContainer.append(node("p", "", "No requests have been submitted."));
  } else {
    data.requests.forEach(r => {
      const row = node("div", "activity");
      const left = node("div");
      left.append(
        node("div", "activity-title", r.title),
        node("div", "activity-detail", r.type + " · Submitted " + r.date),
        node("span", "badge badge-amber", r.status)
      );
      row.append(left);
      requestContainer.append(row);
    });
  }

  el("preview-intro").textContent = data.state.intro;
  el("preview-priorities").textContent = data.state.priorities;
  el("preview-news").textContent = data.state.news || "No announcements yet.";
  el("preview-contact").textContent = data.state.contact || "Not provided.";

  const resourceContainer = el("preview-resources");
  resourceContainer.replaceChildren();
  if (!data.resources.length) {
    resourceContainer.append(node("p", "", "No resources published yet."));
  } else {
    data.resources.forEach(r => {
      const article = node("article");
      article.append(
        node("strong", "", r.title + " (" + r.type + ")"),
        node("p", "", r.description)
      );
      if (r.url) {
        try {
          const url = new URL(r.url);
          if (["https:", "http:"].includes(url.protocol)) {
            const link = node("a", "", "View resource");
            link.href = url.href;
            link.target = "_blank";
            link.rel = "noopener noreferrer";
            article.append(link);
          }
        } catch (error) { /* Ignore invalid URLs */ }
      }
      resourceContainer.append(article, node("hr"));
    });
  }
}

function populateEditor() {
  el("state-intro").value = data.state.intro;
  el("state-priorities").value = data.state.priorities;
  el("state-news").value = data.state.news;
  el("state-contact").value = data.state.contact;
}

document.querySelectorAll("[data-section]").forEach(button => {
  button.addEventListener("click", () => showSection(button.dataset.section));
});
document.querySelectorAll("[data-go]").forEach(button => {
  button.addEventListener("click", () => showSection(button.dataset.go));
});

el("state-form").addEventListener("submit", event => {
  event.preventDefault();
  const input = [
    value("state-intro"),
    value("state-priorities"),
    value("state-news")
  ].join(" ").toLowerCase();

  // This is just a demo prompt, not a reliable approval safeguard.
  // Production rules must be enforced server-side.
  if (/\b(support|oppose|vote for|vote against|contact your legislator)\s+(hb|sb|hr|s\.|bill\s+\d)/i.test(input)) {
    notify("This may contain a legislative position or campaign request. Please submit it for national review instead.");
    return;
  }

  data.state = {
    intro: value("state-intro"),
    priorities: value("state-priorities"),
    news: value("state-news"),
    contact: value("state-contact")
  };
  data.updateCount++;
  addActivity("State page updated", "Published in local demonstration");
  saveData();
  notify("Your routine updates were saved to the demo page.");
});

el("resource-form").addEventListener("submit", event => {
  event.preventDefault();
  data.resources.unshift({
    type: value("resource-type"),
    title: value("resource-title"),
    description: value("resource-description"),
    url: value("resource-url")
  });
  data.updateCount++;
  addActivity("Resource published", value("resource-title"));
  saveData();
  event.target.reset();
  notify("Resource saved to the demo state page.");
});

function submitRequest(type, title, detail) {
  data.requests.unshift({
    type, title, detail,
    status: "Pending National Review",
    date: new Date().toLocaleDateString()
  });
  addActivity(type + " requested", title);
  saveData();
  notify("Request saved to the demonstration approval queue. It has not been sent to CASE national.");
}

el("position-form").addEventListener("submit", event => {
  event.preventDefault();
  submitRequest(
    "Legislative Position",
    value("bill-number") + ": " + value("bill-title"),
    value("position-choice") + " — " + value("position-reason")
  );
  event.target.reset();
});

el("campaign-form").addEventListener("submit", event => {
  event.preventDefault();
  submitRequest(
    "Grassroots Campaign",
    value("campaign-title"),
    value("campaign-goal") + " — " + value("campaign-description")
  );
  event.target.reset();
});

populateEditor();
refresh();
</script>
</body>
</html>
